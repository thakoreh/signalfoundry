# Explicit opt-in. Both values must match. Rebuild Next.js after changing mode.
SIGNALFOUNDRY_MODE=local-demo
NEXT_PUBLIC_SIGNALFOUNDRY_MODE=local-demo
API_BASE_URL=http://127.0.0.1:8000

# Authenticated SaaS (replace BOTH modes above with saas).
# Configure actual values in your deployment secret manager. Never commit secrets.
# APP_URL=https://your-application-origin
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CONVEX_URL=
# CLERK_JWT_TEMPLATE=convex
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# Clerk organizations must be enabled, with org:admin and org:member roles.
# Activate the Clerk Convex integration and include active organization claims.
# Convex provider credentials, Stripe credentials, webhook secret, allowed price,
# and plan limits belong on the Convex deployment, never in NEXT_PUBLIC_* values.
