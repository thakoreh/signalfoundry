# Operator-provided server-side settings only. Never use NEXT_PUBLIC_/VITE_ names.
# Do not commit populated copies or supply secrets as image build arguments.
SIGNALFOUNDRY_WORKER_URL=
SIGNALFOUNDRY_WORKER_TOKEN=
SIGNALFOUNDRY_TRUSTED_PROXY_IPS=
SIGNALFOUNDRY_WORKER_ALLOW_PRIVATE_HTTP=false
DECISION_ENGINE=rules
# Only configure JEV_API_KEY after explicit approval for external paid processing.
JEV_API_KEY=
# Customer discovery stays disabled until explicitly enabled by the operator.
CLIENTROVE_SEARCH_PROVIDER=deepseek
CLIENTROVE_DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
# Separate explicit opt-in for AI message drafts; no sending capability.
CLIENTROVE_DEEPSEEK_DRAFTS_ENABLED=false
# Optional email lookup and verification; research works without Hunter.
CLIENTROVE_HUNTER_ENABLED=false
HUNTER_API_KEY=
# Optional alternative, never an automatic paid fallback.
CLIENTROVE_BRAVE_SEARCH_ENABLED=false
BRAVE_SEARCH_API_KEY=
