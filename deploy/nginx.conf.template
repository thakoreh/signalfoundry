worker_processes 1;
pid /tmp/signalfoundry-nginx.pid;
error_log stderr warn;
events { worker_connections 128; }
http {
    # Long generated preview hosts/origins exceed NGINX's default map bucket.
    map_hash_bucket_size 128;
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/signalfoundry-client;
    proxy_temp_path /tmp/signalfoundry-proxy;
    fastcgi_temp_path /tmp/signalfoundry-fastcgi;
    uwsgi_temp_path /tmp/signalfoundry-uwsgi;
    scgi_temp_path /tmp/signalfoundry-scgi;
    client_max_body_size 64k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    limit_req_zone $binary_remote_addr zone=preview_requests:1m rate=10r/s;
    limit_conn_zone $binary_remote_addr zone=preview_connections:1m;
    map $http_host $allowed_host {
        default 0;
        @@HOST@@ 1;
        @@HOST@@:443 1;
    }
    map $http_origin $allowed_origin {
        default 0;
        "" 1;
        "@@ORIGIN@@" 1;
    }
    map $http_x_forwarded_host $allowed_forwarded_host {
        default 0;
        "" 1;
        @@HOST@@ 1;
        @@HOST@@:443 1;
    }
    server {
        listen 8080 default_server;
        server_name @@HOST@@;
        if ($allowed_host = 0) { return 403; }
        if ($allowed_origin = 0) { return 403; }
        if ($allowed_forwarded_host = 0) { return 403; }
        if ($http_forwarded != "") { return 403; }
        if ($http_x_forwarded_proto != "https") { return 426; }
        auth_basic "SignalFoundry private preview";
        auth_basic_user_file @@PASSWORD_FILE@@;
        limit_req zone=preview_requests burst=30 nodelay;
        limit_req_status 429;
        limit_conn preview_connections 20;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control "no-store" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        location / {
            proxy_pass http://127.0.0.1:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            # The Basic password never reaches the application or its public-web fetches.
            proxy_set_header Authorization "";
            proxy_set_header Connection "";
            proxy_connect_timeout 5s;
            proxy_send_timeout 15s;
            proxy_read_timeout 180s;
            proxy_buffering off;
        }
    }
}
